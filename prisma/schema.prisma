generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The pooled URL is for app queries; migrations need the direct, non-pooled URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String    @id @default(cuid())
  name        String    @unique
  // Store money as integer cents so floating-point rounding cannot change totals.
  priceCents  Int
  isActive    Boolean   @default(true)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// The person who manages the bakery (only Abril for now). There is no sign-up
// screen: Juan creates or resets the account with `npm run admin:password`.
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  // "scrypt$N$r$p$salt$hash" (src/lib/auth/password.ts). Never the password.
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One row per device where Abril is logged in. "Salir" deletes it; resetting
// the password deletes all of them.
model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the cookie token (src/lib/auth/session-token.ts).
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

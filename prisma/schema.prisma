generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The pooled URL is for app queries; migrations need the direct, non-pooled URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  // Store money as integer cents so floating-point rounding cannot change totals.
  priceCents  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
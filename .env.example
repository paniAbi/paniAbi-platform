# Local Docker database (docker-compose.yml). Start it with: npm run db:local
# These values only work on your computer, so they are not secrets.

# Pooled connection. Used by the running application.
DATABASE_URL="postgresql://paniabi:paniabi@localhost:5432/paniabi"

# Direct connection. Used by Prisma migrations only.
DIRECT_URL="postgresql://paniabi:paniabi@localhost:5432/paniabi"

# Neon instead (only when Juan asks you to). He sends both URLs privately:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

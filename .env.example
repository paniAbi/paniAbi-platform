# Each teammate uses their own Neon database branch. Ask Juan for both URLs so a migration never interrupts someone else's work.

# Neon connection — pooled. Used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon connection — direct, no pooler. Used by Prisma migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"